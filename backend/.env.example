# ═══════════════════════════════════════════════════════════════
# APPLICATION
# ═══════════════════════════════════════════════════════════════
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
FRONTEND_URL=http://localhost:3000
INTERNAL_API_SECRET=generate-32-char-random-hex-here-min-32-chars

# ═══════════════════════════════════════════════════════════════
# DATABASE — POSTGRESQL (SUPABASE)
# ═══════════════════════════════════════════════════════════════
# Runtime queries — via Supabase PgBouncer pooler (port 6543)
DATABASE_URL=postgresql://postgres.[project]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Migrations only — direct connection (port 5432, bypasses pooler)
DATABASE_DIRECT_URL=postgresql://postgres:[password]@db.[project].supabase.co:5432/postgres
# Local dev (docker-compose postgres)
# DATABASE_URL=postgresql://vividcrm:vividcrm_dev@localhost:5432/vividcrm_dev

# ═══════════════════════════════════════════════════════════════
# REDIS
# ═══════════════════════════════════════════════════════════════
# Local dev: redis://:vividcrm_redis_dev@localhost:6379
# Upstash production: rediss://default:[password]@[endpoint]:6380
REDIS_URL=redis://:vividcrm_redis_dev@localhost:6379
REDIS_KEY_PREFIX=dev

# ═══════════════════════════════════════════════════════════════
# AUTHENTICATION — JWT
# ═══════════════════════════════════════════════════════════════
JWT_ACCESS_SECRET=REPLACE_WITH_64_CHAR_RANDOM_HEX_DO_NOT_USE_IN_PRODUCTION_EVER
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_64_CHAR_RANDOM_HEX_NOT_SAME_AS_ACCESS
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800
REFRESH_COOKIE_NAME=vcrm_rt

# ═══════════════════════════════════════════════════════════════
# FILE STORAGE — CLOUDFLARE R2
# ═══════════════════════════════════════════════════════════════
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=vividcrm-dev
R2_PUBLIC_URL=https://cdn-dev.vividcrm.in
R2_ENDPOINT=https://[account_id].r2.cloudflarestorage.com
R2_SIGNED_URL_EXPIRY=300

# ═══════════════════════════════════════════════════════════════
# EMAIL — BREVO
# ═══════════════════════════════════════════════════════════════
BREVO_API_KEY=xkeysib-REPLACE_WITH_ACTUAL_KEY
BREVO_FROM_EMAIL=noreply@vividcrm.in
BREVO_FROM_NAME=VividCRM
# Local dev: use Mailpit (local SMTP capture)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USE_BREVO_API=false

# ═══════════════════════════════════════════════════════════════
# DATA ENCRYPTION (for sensitive HR fields)
# ═══════════════════════════════════════════════════════════════
DATA_ENCRYPTION_KEY=generate-64-char-hex-key-for-aes-256-encryption-never-reuse

# ═══════════════════════════════════════════════════════════════
# BULLMQ
# ═══════════════════════════════════════════════════════════════
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=REPLACE_WITH_STRONG_PASSWORD

# ═══════════════════════════════════════════════════════════════
# RATE LIMITING
# ═══════════════════════════════════════════════════════════════
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PUBLIC_PER_MINUTE=20
RATE_LIMIT_EXPORT_PER_HOUR=5

# ═══════════════════════════════════════════════════════════════
# PDF GENERATION — CHROMIUM
# ═══════════════════════════════════════════════════════════════
CHROMIUM_PATH=
PDF_CONCURRENCY=3

# ═══════════════════════════════════════════════════════════════
# ERROR TRACKING — SENTRY
# ═══════════════════════════════════════════════════════════════
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_RELEASE=local
SENTRY_TRACES_SAMPLE_RATE=0.1

# ═══════════════════════════════════════════════════════════════
# LOGGING
# ═══════════════════════════════════════════════════════════════
LOG_LEVEL=debug
LOG_FORMAT=pretty
LOG_HTTP_REQUESTS=true

# ═══════════════════════════════════════════════════════════════
# FEATURE FLAGS
# ═══════════════════════════════════════════════════════════════
FEATURE_PUBLIC_SIGNUP=false
FEATURE_SWAGGER=true
FEATURE_BULL_BOARD=true
FEATURE_DETAILED_ERRORS=true
MAX_FILE_SIZE=10485760
DATABASE_QUERY_LOG=false
